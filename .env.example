# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/delivery_db
# Used only by tests (separate database, never the main one)
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/delivery_test

# Authentication
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=add long urlsafe string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Password hashing: parallel Argon2 hashes
# min(CPU cores / 4, memory budget in MB / 64), at least 1; multiply by worker count
HASH_CONCURRENCY=4

# API
# true = /docs, /redoc and /openapi.json are available (development only)
DOCS_ENABLED=false

# Comma-separated list of allowed browser origins, e.g. https://example.com,http://localhost:3000
# Leave empty to disable CORS (no browser site can call the API)
CORS_ORIGINS=